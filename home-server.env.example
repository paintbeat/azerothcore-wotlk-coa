# Required. Generate a unique alphanumeric password, for example:
# openssl rand -hex 24
COA_DB_ROOT_PASSWORD=replace-with-a-long-random-password

# Docker VM LAN address. For the current dockerholder VM this is expected to be
# 192.168.0.36; confirm with: hostname -I
COA_BIND_IP=192.168.0.36
COA_REALM_ADDRESS=192.168.0.36

# Deployment tuning for the current 16-thread / 11 GiB Docker VM.
COA_BUILD_JOBS=4
COA_DATA_ROOT=/srv/azerothcore
COA_DB_MEMORY_LIMIT=1536m
COA_AUTH_MEMORY_LIMIT=512m
COA_WORLD_MEMORY_LIMIT=3g

# Optional identity and LAN settings.
COA_REALM_NAME=Conquest of Azeroth
COA_REALM_LOCAL_ADDRESS=192.168.0.36
COA_REALM_LOCAL_SUBNET_MASK=255.255.255.0
COA_AUTH_PORT=3724
COA_WORLD_PORT=8085
COA_IMAGE_TAG=local
COA_USER_ID=1000
COA_GROUP_ID=1000
COA_DOCKER_USER=acore

