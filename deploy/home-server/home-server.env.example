# Copy these values into Portainer's stack environment-variable section.
# Do not commit a real password.

COA_ROOT=/srv/azerothcore-coa
COA_DB_ROOT_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
COA_BIND_ADDRESS=0.0.0.0
COA_AUTH_PORT=3724
COA_WORLD_PORT=8085
COA_IMAGE_TAG=home
DOCKER_USER=acore
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000
TZ=America/Chicago

# Leave this unset for the initial database/client-data preparation.
# Add it only after the matching CoA repack data has been copied and verified.
# COMPOSE_PROFILES=server
